{
  "name": "back-end",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch ./src/bin/server.ts",
    "start": "node ./dist/src/bin/server.js",
    "build": "prisma generate && rimraf dist && tsc",
    "prestart": "npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "morgan": "^1.10.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.21.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "prisma": "^7.9.1",
    "rimraf": "^6.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
